DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Optional migration-only PostgreSQL connection (Supabase direct or session pooler URL).
# Add the SSL settings required by your provider to the URL. Never use NEXT_PUBLIC_* here.
MIGRATION_DATABASE_URL=
# Required in production: generate a random secret of at least 32 characters.
SESSION_SECRET=
# Production: exact canonical HTTPS origin registered in Yandex OAuth (no path).
# Server-only SITE_URL overrides NEXT_PUBLIC_SITE_URL when set.
SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Telegram Login Widget authentication (server-side bot token).
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_NAME=
# Optional: Yandex OAuth.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Optional: Supabase Storage uploads. Never expose the service key as NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
